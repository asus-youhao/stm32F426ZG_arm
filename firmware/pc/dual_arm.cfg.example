# dual_arm.cfg — pc_master --config 範例（項目 7）
# key=value 覆寫編譯期預設;# 為註解。未列的鍵維持預設。
# WP0.4 實機量測值放這裡,免重編譯、逐機一份。

# ---- 軸表（joint 0..13 = 左 J1..J7、右 J1..J7;* = 全軸）----
# EYOU 19-bit 輸出端：524288/2π（實機以 0x2025 讀值確認後填入）
joint.*.counts_per_rad = 83443.03
joint.*.vmax = 2.0            # rad/s
joint.*.amax = 8.0            # rad/s^2

# 肩部大關節（PHU20）保守一點
joint.0.vmax = 1.5
joint.1.vmax = 1.5
joint.7.vmax = 1.5
joint.8.vmax = 1.5

# 限位（rad;實機依機構量測）
joint.3.q_min = -0.1          # 左肘不反折
joint.3.q_max = 2.4
joint.10.q_min = -0.1         # 右肘
joint.10.q_max = 2.4

# 機械零點偏移（佈建 SOP 校零後填入）
joint.0.offset_rad = 0.0

# ---- IK ----
ik.lambda = 0.05
ik.step_gain = 0.5
ik.max_iters = 100
ik.pos_tol = 0.001            # m
ik.rot_tol = 0.01             # rad

# ---- 初始姿態（rad,7 軸,左右共用）----
q_init.1 = 0.3
q_init.3 = 0.7
q_init.5 = 0.5

# ---- 肩基座（世界座標,m）----
base.left.y = 0.20
base.right.y = -0.20

# ---- DH（實機機構量測後填;theta = theta_off）----
# dh.left.2.d = 0.30
# dh.right.2.d = 0.30
